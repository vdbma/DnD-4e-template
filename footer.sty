
\NeedsTeXFormat{LaTeX2e}

% ==========================================
% Dependencies
% ==========================================

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{eso-pic}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}


% ==========================================
% Configuration
% ==========================================

\makeatletter
\def\dnd@phbblue{phbblue}
\def\dnd@dmgred{dmgred}
\def\dnd@mmgreen{mmgreen}

\edef\dnd@currentcolor{\maincolor}

\newcommand{\dndFooterImage}{%
    \ifx\dnd@currentcolor\dnd@phbblue
        img/footerphbblue.png%
    \else\ifx\dnd@currentcolor\dnd@dmgred
        img/footerdmgred.png%
    \else\ifx\dnd@currentcolor\dnd@mmgreen
        img/footermmgreen.png%
    \else
        img/footerphbblue.png%
    \fi\fi\fi
}

\newcommand{\SetdndFooterImage}[1]{%
    \renewcommand{\dndFooterImage}{#1}%
}

% Image dimensions
\newcommand{\dndFooterWidth}{0.25\paperwidth}
%\newcommand{\dndFooterHeight}{42mm}

% Chapter title
\renewcommand{\chaptermark}[1]{%
    \markboth{#1}{}%
}
\newcommand{\dndFooterTitle}{%
    CHAPTER \thechapter\ \textbar\ \textbf{\textit{\leftmark}}%
}

% ==========================================
% Background image
% ==========================================

% Even pages: image on the left
\newcommand{\dnd@backgroundleft}{%
    \AtPageLowerLeft{%
        \includegraphics[
            width=\dndFooterWidth
        ]{\dndFooterImage}%
    }%
}

% Odd pages: image on the right, mirrored
\newcommand{\dnd@backgroundright}{%
    \AtPageLowerLeft{%
        \makebox[\paperwidth][r]{%
            \reflectbox{%
                \includegraphics[
                    width=\dndFooterWidth
                ]{\dndFooterImage}%
            }%
        }%
    }%
}

% ==========================================
% Foreground text
% ==========================================


% ==========================================
% Foreground text
% ==========================================

\newcommand{\dnd@textleft}{%
    \AtPageLowerLeft{%
        \begin{tikzpicture}[remember picture, overlay]
            % Page number
            \node[
                anchor=center,
                text=white,
                font=\FontLolth\bfseries\Large
            ] at ([xshift=0.055\paperwidth,yshift=0.06\paperwidth]current page.south west) {\thepage};

            % Chapter title
            \node[
                anchor=west,
                text=black,
                font=\rmfamily\large
            ] at ([xshift=0.17\paperwidth,yshift=0.08\paperwidth]current page.south west) {\dndFooterTitle};
        \end{tikzpicture}%
    }%
}

\newcommand{\dnd@textright}{%
    \AtPageLowerLeft{%
        \begin{tikzpicture}[remember picture, overlay]
            % Page number
            \node[
                anchor=center,
                text=white,
                font=\sffamily\bfseries\Large
            ] at ([xshift=-0.055\paperwidth,yshift=0.06\paperwidth]current page.south east) {\thepage};


            % Chapter title
            \node[
                anchor=east,
                text=black,
                font=\rmfamily\large
            ] at ([xshift=-0.17\paperwidth,yshift=0.08\paperwidth]current page.south east) {\dndFooterTitle};

        \end{tikzpicture}%
    }%
}

% ==========================================
% Page styles
% ==========================================

\fancypagestyle{dnd}{%
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}

\fancypagestyle{plain}{%
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}

% ==========================================
% Shipout registration
% ==========================================

\AddToShipoutPictureBG{%
    \ifodd\value{page}
        \dnd@backgroundright
        \dnd@textright
    \else
        \dnd@backgroundleft
        \dnd@textleft
    \fi
}




% ==========================================
% Right page header
% ==========================================

% Total chapters (loaded from previous compilation)
\providecommand{\dndTotalChapters}{1}

% Save total chapter count at end of document
\AtEndDocument{%
    \immediate\write\@auxout{%
        \string\gdef\string\dndTotalChapters{\number\value{chapter}}%
    }%
}

\ifnum\dndTotalChapters=1
    \pgfmathsetmacro{\dndHeaderProgress}{0.5}
\else
    \pgfmathsetmacro{\dndHeaderProgress}{%
        (\value{chapter}-1)/(\dndTotalChapters-1)
    }
\fi

\pgfmathsetlengthmacro{\dndHeaderOffset}{%
    \dndHeaderProgress*0.20*\paperheight
}

\renewcommand{\sectionmark}[1]{%
    \markright{#1}%
}

\newcommand{\dnd@rightheader}{%
    \AtPageUpperLeft{%
        \begin{tikzpicture}[remember picture, overlay]

            % Decorative PNG
            \node[anchor=north east, inner sep=0pt]
            at ([xshift=0pt,yshift=-\dndHeaderOffset]current page.north east)
            {\includegraphics[height=0.075\paperheight]{img/sidenumber.png}};

            % Chapter number
            \node[
                anchor=center,
                font=\FontLolth\bfseries\Huge,
                text=white
            ] at ([xshift=-0.03\paperheight,yshift=-0.04\paperheight-\dndHeaderOffset]current page.north east)
                {\thechapter};

            % Section title (vertical, uppercase)
            \node[
                rotate=90,
                anchor=center,
                font=\sffamily\bfseries\small,
                text=olive
            ] at ([xshift=-0.1\paperwidth,yshift=-0.15\paperheight]current page.north east)
                {\MakeUppercase{\rightmark}};



        \end{tikzpicture}%
    }%
}

% Display only on right-hand pages
\AddToShipoutPictureBG{%
    \ifodd\value{page}
        \dnd@rightheader
    \fi
}




























\makeatother

\pagestyle{dnd}